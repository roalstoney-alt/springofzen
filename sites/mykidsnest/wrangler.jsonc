{
  "$schema": "../../node_modules/.pnpm/wrangler@4.147.0/node_modules/wrangler/config-schema.json",
  "name": "mykidsnest-site",
  "main": "src/worker.js",
  "account_id": "f2e22e5cefa40fa25e8a461a149ae12c",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "mykidsnest-leads",
      "database_id": "4b743455-eaa0-49ee-a620-4449f1ff9398",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "LEAD_COLLECTION_ENABLED": "true",
    "LEAD_POLICY_APPROVED": "2026-10-16-v1",
    "LEAD_RETENTION_READY": "true"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "routes": [
    { "pattern": "mykidsnest.com", "custom_domain": true },
    { "pattern": "www.mykidsnest.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
