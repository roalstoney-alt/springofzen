{
  "$schema": "../../node_modules/.pnpm/wrangler@4.147.0/node_modules/wrangler/config-schema.json",
  "name": "mykidsnest-site",
  "main": "src/worker.js",
  "account_id": "f2e22e5cefa40fa25e8a461a149ae12c",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "mykidsnest.com", "custom_domain": true },
    { "pattern": "www.mykidsnest.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
